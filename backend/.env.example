# ====================================================================
# 校园取件 App · 后端环境变量模板
# --------------------------------------------------------------------
# 使用方式：复制为 .env 并按实际填写。.env 文件禁止提交到 git。
# 安全约束：所有 SecretId/SecretKey/AppSecret 必须通过环境变量注入，
#          前端 JS 永远不接触这些值。
# ====================================================================

# ---------- 运行环境 ----------
# development = 本地开发（mock 数据，控制台验证码）
# gray        = 灰度测试（真实第三方 + 小范围真实用户）
# production  = 正式上线（暂不启用）
ENVIRONMENT=development
PORT=3000

# ---------- JWT ----------
# 生产请用强随机字符串（>=32 字符），并定期轮换
JWT_SECRET=please-change-me-to-strong-random-string

# ---------- 数据库 ----------
# SQLite 文件路径（相对 backend/ 目录）
DATABASE_PATH=data/campus.sqlite

# ---------- 短信服务 ----------
# Provider 选择：console(开发) | tencent(腾讯云SMS) | aliyun(阿里云SMS)
SMS_PROVIDER=console

# 腾讯云 SMS（推荐，灰度阶段使用）
# 文档：https://cloud.tencent.com/document/product/382
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=校园取件
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou

# 阿里云 SMS（备用）
# 文档：https://help.aliyun.com/product/44282.html
ALIYUN_SMS_ACCESS_KEY=
ALIYUN_SMS_SECRET=
ALIYUN_SMS_SIGN_NAME=校园取件
ALIYUN_SMS_TEMPLATE_CODE=

# ---------- 快递服务 ----------
# Provider 选择：kdniao(快递鸟) | cainiao(菜鸟占位)
COURIER_PROVIDER=kdniao

# 快递鸟 API（https://www.kdniao.com/）
KDNIAO_EBUSINESS_ID=
KDNIAO_API_KEY=

# 菜鸟驿站 API（占位，未实现）
CAINIAO_APP_KEY=
CAINIAO_APP_SECRET=

# ---------- 微信登录（占位） ----------
# 当前阶段未开放。获得开放平台资质后填写，并将 WECHAT_LOGIN_ENABLED 改 true
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_LOGIN_ENABLED=false

# ---------- 灰度阶段 ----------
# 灰度批次：wave1(5-10) / wave2(20-50) / wave3(100)
GRAY_COHORT=wave1

# ---------- 日志与脱敏 ----------
# 手机号日志脱敏保留前 N 位
PHONE_MASK_KEEP_HEAD=3
PHONE_MASK_KEEP_TAIL=4

# ---------- HTTPS（可选，本地开发用） ----------
# 开发环境可生成自签证书；生产请使用 Let's Encrypt 或反向代理
HTTPS_ENABLED=false
HTTPS_KEY_PATH=./certs/dev.key
HTTPS_CERT_PATH=./certs/dev.crt

# ---------- AI 助手（DeepSeek 后端代理） ----------
# 仅在服务端使用，由 routes/ai.js 注入 Authorization 头；前端永远拿不到此 key
# 申请：https://platform.deepseek.com/  留空则 /api/ai/chat 返回 503，前端自动回退本地规则引擎
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
