# backend/.env.example — 复制为 backend/.env 后填入真实值；.env 已被 .gitignore 排除，严禁提交
# 轮换策略：每把 key 建议 90 天更换一次，并在「上次更换」处记录日期
# 限额策略：每把 key 在服务商控制台设置用量上限与告警

# 服务器端口
PORT=3000

# JWT 密钥（随机字符串）
JWT_SECRET=

# 阿里云 SMS（真实短信时填写）— 上次更换：—
ALIYUN_SMS_ACCESS_KEY=
ALIYUN_SMS_SECRET=

# 快递鸟 API（https://www.kdniao.com/）— 上次更换：—
KDNIAO_EBUSINESS_ID=
KDNIAO_API_KEY=
